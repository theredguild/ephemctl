description: Run code-server via podman
compatibility:
  profiles: [headless, desktop]
  os_family: [fedora, ubuntu]
depends_on: [podman-host]

provision:
  user_commands:
    - |
      podman rm -f code-server >/dev/null 2>&1 || true
      podman volume inspect code-server-local >/dev/null 2>&1 || podman volume create code-server-local >/dev/null
      podman volume inspect code-server-config >/dev/null 2>&1 || podman volume create code-server-config >/dev/null
      mkdir -p /home/{guest_user}/workspace
      podman run -d --replace --name code-server --restart=unless-stopped \
        -p 0.0.0.0:8443:8080 \
        -v /home/{guest_user}/workspace:/home/coder/project:Z \
        -v code-server-local:/home/coder/.local \
        -v code-server-config:/home/coder/.config \
        ghcr.io/coder/code-server:latest

live:
  user: dev
  commands:
    - |
      # Ensure podman is available (idempotent for live apply on bare VMs)
      if ! command -v podman >/dev/null 2>&1; then
        if command -v dnf >/dev/null 2>&1; then
          sudo dnf install -y podman crun slirp4netns fuse-overlayfs container-selinux
        elif command -v apt-get >/dev/null 2>&1; then
          sudo apt-get update && sudo apt-get install -y podman
        fi
      fi
      mkdir -p /home/{guest_user}/workspace
      podman run -d --replace --name code-server --restart=unless-stopped -p 0.0.0.0:8443:8080 -v /home/{guest_user}/workspace:/home/coder/project:Z ghcr.io/coder/code-server:latest

verify: podman ps | grep -q code-server && echo "[OK] code-server running" || echo "[FAIL] code-server not running"
