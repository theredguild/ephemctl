profile: desktop
os_family: fedora
description: Minimal desktop with Openbox WM, lxpanel, and xterm
base_image: fedora43-base.qcow2
cpus: 2
memory: 4096
disk_size: 20G
guest_user: dev
passwordless_sudo: true

ephemeral:
  transient: false
  destroy_on_stop: false

network:
  mode: nat
  mgmt_ip: 10.31.0.3
  mgmt_prefix: 24

security:
  selinux: true
  no_guest_agent: true
  restrict_network: false

provision:
  packages:
    - firefox
    - openssh-clients
    - openssh-server
    - spice-vdagent
    - xorg-x11-server-Xorg
    - xorg-x11-xinit
    - xorg-x11-drv-qxl
    - mesa-dri-drivers
    - openbox
    - lxpanel
    - xterm
  write_files:
    - path: /home/{guest_user}/.xinitrc
      owner: "{guest_user}:{guest_user}"
      permissions: "0644"
      content: |
        #!/bin/bash
        lxpanel &
        exec openbox-session
    - path: /home/{guest_user}/.config/openbox/autostart
      owner: "{guest_user}:{guest_user}"
      permissions: "0644"
      content: |
        # Openbox autostart
        xterm &
    - path: /home/{guest_user}/.bash_profile
      owner: "{guest_user}:{guest_user}"
      permissions: "0644"
      content: |
        # Auto-start X on first virtual console
        if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
            exec startx
        fi
    - path: /etc/systemd/system/getty@tty1.service.d/autologin.conf
      owner: root:root
      permissions: "0644"
      content: |
        [Service]
        ExecStart=
        ExecStart=-/usr/sbin/agetty --autologin {guest_user} --noclear %I $TERM
  root_commands:
    - systemctl enable --now sshd
    - mkdir -p /home/{guest_user}/.config/openbox /home/{guest_user}/Downloads /home/{guest_user}/workspace /home/{guest_user}/.ssh
    - chown -R {guest_user}:{guest_user} /home/{guest_user}
    - restorecon -RF /home/{guest_user} || true
    - systemctl daemon-reload
    - systemctl restart getty@tty1
    - systemctl set-default graphical.target
